# Copy this file to wrangler.toml and fill in real values LOCALLY.
# Do NOT commit your real KV namespace id, extension id, or account id.
#
# Requires the Workers PAID plan (not Free) — RATE_LIMITER_DO is a Durable
# Object, which Cloudflare doesn't offer on the Free tier. `wrangler deploy`
# will fail on the [[migrations]] block below if you're on Free.
#
# Steps:
#   1. cp wrangler.toml.example wrangler.toml
#   2. npx wrangler login                               # CF auth
#   3. npx wrangler kv namespace create MARKET_CACHE     # copy returned id below
#      (RATE_LIMITER_DO needs no separate creation step — `wrangler deploy`
#      provisions it from the [[migrations]] block below.)
#   4. Edit the `id =` line below with the returned id
#   5. Set ALLOWED_EXTENSION_ID to your unpacked / CWS extension id
#      (chrome://extensions → toggle Developer mode → copy ID).
#      Comma-separated list supported, e.g. "dev_id,prod_id".
#   6. Set secrets via wrangler:
#      openssl rand -hex 32 | npx wrangler secret put WORKER_SHARED_SECRET
#      npx wrangler secret put OPENAI_API_KEY     # optional
#   7. npx wrangler deploy

name = "actually-api"
main = "index.ts"
compatibility_date = "2025-01-01"
compatibility_flags = ["nodejs_compat"]
workers_dev = true

# Optional: pin to a specific CF account. Otherwise inherits from wrangler login.
# account_id = "YOUR_CF_ACCOUNT_ID"

# Atomic rate limiting + OpenAI daily cap (see worker/index.ts's RateLimiterDO).
# Durable Object storage is provisioned automatically by `wrangler deploy` via
# the [[migrations]] block — no `wrangler kv namespace create`-style manual
# step needed, unlike the KV namespaces below.
[[durable_objects.bindings]]
name = "RATE_LIMITER_DO"
class_name = "RateLimiterDO"

[[migrations]]
tag = "v1-rate-limiter" # bump the tag if RateLimiterDO's class ever changes shape
new_sqlite_classes = ["RateLimiterDO"]

[[kv_namespaces]]
binding = "MARKET_CACHE"
id = "YOUR_KV_NAMESPACE_ID"

# Optional: telemetry persistence. Without this binding /telemetry just logs
# counts. With it, each event is written as a data point you can query in the
# CF dashboard. Create the dataset implicitly by deploying with this binding.
# [[analytics_engine_datasets]]
# binding = "TELEMETRY"
# dataset = "actually_telemetry"

[vars]
ALLOWED_EXTENSION_ID = "YOUR_EXTENSION_ID"
WORKER_DEV_MODE = ""  # set to "true" only for local dev
# Aggregate daily cap on embedded characters across all clients (≈ tokens).
# OPENAI_DAILY_CHAR_LIMIT = "5000000"

# Secrets — DO NOT put in this file. Use wrangler secret put.
#   WORKER_SHARED_SECRET — random 32+ chars, baked into extension as VITE_WORKER_SECRET
#   OPENAI_API_KEY       — only for centralized OpenAI embedding fallback
#   MARKET_CACHE_WRITE_SECRET — random 32+ chars (openssl rand -hex 32). Set
#                             via `wrangler secret put MARKET_CACHE_WRITE_SECRET`.
#                             Distinct from WORKER_SHARED_SECRET: the shared
#                             secret is baked into public clients (extension,
#                             any MCP server operator) by design and offers no
#                             real protection; this one guards who can OVERWRITE
#                             the precomputed market cache and must stay private
#                             to the precompute cron job only.
