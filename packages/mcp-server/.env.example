# Copy to .env.local for local dev/testing (gitignored by the repo-root
# .gitignore). This file is for OPERATOR runtime config only — see the
# bottom of this file for why the builder code does NOT belong here.
#
# `npm run dev` (tsx) does not auto-load .env files. Either export these in
# your shell before running, or after `npm run build`, run the built server
# with Node's native env-file flag (Node 20.6+):
#   node --env-file=.env.local dist/index.js

# --- Required: backing Worker (read-only market data + market-cache) ---
ACTUALLY_WORKER_URL=https://your-worker.workers.dev
# Public-by-design shared secret — same posture as the browser extension's
# baked VITE_WORKER_SECRET. The real backstop is the Worker's rate limiting,
# not secrecy of this value.
ACTUALLY_WORKER_SECRET=replace-with-worker-shared-secret

# --- Optional: enables place_order/sell_order/cancel_order/get_open_orders/
#     get_positions/redeem_position. Omit entirely to run signal-only
#     (check_news/get_market), which needs no wallet. ---
# Your own Polygon EOA private key. NEVER shared with or seen by the
# actually-mcp-server maintainers — it stays in your own process env.
# POLYMARKET_PRIVATE_KEY=0xyour-own-private-key-never-committed

# Real-money backstops for place_order/sell_order. Defaults shown — set
# explicitly for any unattended/production use, do not rely on defaults.
ACTUALLY_MAX_ORDER_USD=100
ACTUALLY_DAILY_LIMIT_USD=500

# --- NOT set here: ACTUALLY_BUILDER_CODE ---
# The builder code is baked into dist/index.js at PUBLISH time by tsup's
# `define` (see tsup.config.ts), read from process.env.ACTUALLY_BUILDER_CODE
# at the moment `npm run build` runs — not at server startup, and not
# something an operator installing the published package ever sets. Only
# the maintainer publishing a new version to npm sets this, in their own
# shell or CI secret, immediately before `npm run build && npm publish`.
