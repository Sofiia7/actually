{
  "name": "actually-mcp-server",
  "version": "0.1.4",
  "description": "MCP server that matches news text to Polymarket prediction markets and returns the market's objective probability — plus optional trading tools (place, sell, redeem) using your own wallet.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "polymarket",
    "prediction-markets",
    "probability",
    "news",
    "trading",
    "ai-agents",
    "claude"
  ],
  "license": "MIT",
  "mcpName": "io.github.sofiia7/actually",
  "private": false,
  "type": "module",
  "bin": {
    "actually-mcp-server": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsup",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "tsup"
  },
  "dependencies": {
    "@ethersproject/wallet": "5.8.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@polymarket/builder-relayer-client": "^0.0.10",
    "@polymarket/clob-client-v2": "^1.0.6",
    "@xenova/transformers": "^2.17.2",
    "ethers": "^6.16.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@actually/core": "*",
    "@types/node": "^20.0.0",
    "tsup": "^8.5.1",
    "tsx": "^4.22.4",
    "typescript": "^5.4.5",
    "vitest": "^4.1.10"
  }
}
